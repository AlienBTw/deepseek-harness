{
  "name": "@maple/schedule",
  "description": "Agent-scoped durable after, at, and fixed-rate reminders over the session event log",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlienBTw/maple-harness.git",
    "directory": "packages/schedule/schedule"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@maple/agent": "workspace:^",
    "@maple/brand": "workspace:^",
    "@maple/invariants": "workspace:^",
    "@maple/llm": "workspace:^",
    "@maple/session": "workspace:^",
    "@maple/session-persistence": "workspace:^",
    "@maple/tools": "workspace:^",
    "@maple/cordis": "workspace:^"
  },
  "devDependencies": {
    "@maple/cordis-plugin-loader": "workspace:^",
    "@maple/agent": "workspace:^",
    "@maple/agent-loop": "workspace:^",
    "@maple/agent-loop-testkit": "workspace:^",
    "@maple/brand": "workspace:^",
    "@maple/invariants": "workspace:^",
    "@maple/llm": "workspace:^",
    "@maple/session": "workspace:^",
    "@maple/session-persistence": "workspace:^",
    "@maple/session-persistence-jsonl": "workspace:^",
    "@maple/system-prompt": "workspace:^",
    "@maple/tools": "workspace:^",
    "@maple/cordis": "workspace:^"
  }
}
