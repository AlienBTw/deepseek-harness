{
  "name": "@maple/agent-team",
  "description": "Implicit-root Agent Teams roster, durable peer mailbox, and shared task DAG",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlienBTw/maple-harness.git",
    "directory": "packages/agent-team/agent-team"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@maple/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@maple/agent": "workspace:^",
    "@maple/brand": "workspace:^",
    "@maple/invariants": "workspace:^",
    "@maple/llm": "workspace:^",
    "@maple/session": "workspace:^",
    "@maple/session-persistence": "workspace:^",
    "@maple/session-projection": "workspace:^",
    "@maple/subagent": "workspace:^",
    "@maple/cordis": "workspace:^"
  },
  "devDependencies": {
    "@maple/agent": "workspace:^",
    "@maple/agent-loop": "workspace:^",
    "@maple/agent-loop-testkit": "workspace:^",
    "@maple/brand": "workspace:^",
    "@maple/invariants": "workspace:^",
    "@maple/llm": "workspace:^",
    "@maple/session": "workspace:^",
    "@maple/session-persistence": "workspace:^",
    "@maple/session-persistence-jsonl": "workspace:^",
    "@maple/session-persistence-sqlite": "workspace:^",
    "@maple/session-projection": "workspace:^",
    "@maple/subagent": "workspace:^",
    "@maple/subagent-fork-in-process": "workspace:^",
    "@maple/subagent-spawn-in-process": "workspace:^",
    "@maple/cordis": "workspace:^"
  }
}
