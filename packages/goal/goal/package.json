{
  "name": "@maple/goal",
  "description": "Event-sourced same-session goal state and lifecycle service for the Maple Harness",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlienBTw/maple-harness.git",
    "directory": "packages/goal/goal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@maple/agent": "workspace:^",
    "@maple/session-projection": "workspace:^",
    "@maple/brand": "workspace:^",
    "@maple/invariants": "workspace:^",
    "@maple/llm": "workspace:^",
    "@maple/scope": "workspace:^",
    "@maple/session": "workspace:^",
    "@maple/typert-protocol": "workspace:^",
    "@maple/cordis": "workspace:^"
  },
  "dependencies": {
    "@maple/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@maple/agent": "workspace:^",
    "@maple/session-projection": "workspace:^",
    "@maple/brand": "workspace:^",
    "@maple/invariants": "workspace:^",
    "@maple/llm": "workspace:^",
    "@maple/loader-smoke": "workspace:^",
    "@maple/scope": "workspace:^",
    "@maple/session": "workspace:^",
    "@maple/typert-protocol": "workspace:^",
    "@maple/cordis": "workspace:^"
  }
}
