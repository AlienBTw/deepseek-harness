{
  "name": "@maple/tool-bash",
  "description": "Model-facing bash tool with optional generic background-job and sandbox-escalation support",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlienBTw/maple-harness.git",
    "directory": "packages/shell/tool-bash"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@maple/agent": "workspace:^",
    "@maple/shell": "workspace:^",
    "@maple/shell-env": "workspace:^",
    "@maple/invariants": "workspace:^",
    "@maple/llm": "workspace:^",
    "@maple/sandbox": "workspace:^",
    "@maple/sandbox-policy": "workspace:^",
    "@maple/system-prompt": "workspace:^",
    "@maple/jobs": "workspace:^",
    "@maple/tools": "workspace:^",
    "@maple/user-approval": "workspace:^",
    "@maple/cordis": "workspace:^"
  },
  "dependencies": {
    "@maple/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@maple/agent": "workspace:^",
    "@maple/agent-loop": "workspace:^",
    "@maple/agent-loop-testkit": "workspace:^",
    "@maple/shell": "workspace:^",
    "@maple/shell-env": "workspace:^",
    "@maple/bash-local": "workspace:^",
    "@maple/invariants": "workspace:^",
    "@maple/llm": "workspace:^",
    "@maple/subprocess-local": "workspace:^",
    "@maple/sandbox": "workspace:^",
    "@maple/sandbox-policy": "workspace:^",
    "@maple/session": "workspace:^",
    "@maple/session-persistence-jsonl": "workspace:^",
    "@maple/system-prompt": "workspace:^",
    "@maple/jobs": "workspace:^",
    "@maple/jobs-local": "workspace:^",
    "@maple/tool-jobs": "workspace:^",
    "@maple/tools": "workspace:^",
    "@maple/user-approval": "workspace:^",
    "@maple/cordis": "workspace:^"
  }
}
