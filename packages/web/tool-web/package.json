{
  "name": "@maple/tool-web",
  "description": "Model-facing web tools (web_search, web_fetch) over the Maple Harness web capability seam (ctx.web)",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlienBTw/maple-harness.git",
    "directory": "packages/web/tool-web"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@maple/invariants": "workspace:^",
    "@maple/llm": "workspace:^",
    "@maple/system-prompt": "workspace:^",
    "@maple/tools": "workspace:^",
    "@maple/web": "workspace:^",
    "@maple/cordis": "workspace:^"
  },
  "dependencies": {
    "@joplin/turndown-plugin-gfm": "^1.0.67",
    "@maple/schemastery": "workspace:^",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@maple/agent": "workspace:^",
    "@types/turndown": "^5.0.6",
    "@maple/invariants": "workspace:^",
    "@maple/llm": "workspace:^",
    "@maple/session": "workspace:^",
    "@maple/spill-local": "workspace:^",
    "@maple/spill-policy": "workspace:^",
    "@maple/system-prompt": "workspace:^",
    "@maple/tool-call-timeout-policy": "workspace:^",
    "@maple/tools": "workspace:^",
    "@maple/web": "workspace:^",
    "@maple/web-fetch-http": "workspace:^",
    "@maple/web-search-exa": "workspace:^",
    "@maple/cordis": "workspace:^"
  }
}
