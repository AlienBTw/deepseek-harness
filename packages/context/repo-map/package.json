{
  "name": "@maple/context-repo-map",
  "description": "Proactive Tree-Sitter AST Repo-Map context provider with PageRank personalization",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlienBTw/maple-harness.git",
    "directory": "packages/context/repo-map"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
