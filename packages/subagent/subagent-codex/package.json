{
  "name": "@maple/subagent-codex",
  "description": "One-shot Codex subagent provider over the official app-server protocol",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlienBTw/maple-harness.git",
    "directory": "packages/subagent/subagent-codex"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "maple": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@maple/invariants": "workspace:^",
    "@maple/llm": "workspace:^",
    "@maple/session": "workspace:^",
    "@maple/subagent": "workspace:^",
    "@maple/subprocess": "workspace:^",
    "@maple/timeout": "workspace:^",
    "@maple/cordis": "workspace:^"
  },
  "dependencies": {
    "@maple/sdk-protocol": "workspace:^",
    "@maple/schemastery": "workspace:^",
    "@openai/codex": "0.147.0"
  },
  "devDependencies": {
    "@maple/cordis-plugin-loader": "workspace:^",
    "@maple/agent": "workspace:^",
    "@maple/invariants": "workspace:^",
    "@maple/llm": "workspace:^",
    "@maple/loader-smoke": "workspace:^",
    "@maple/session": "workspace:^",
    "@maple/subagent": "workspace:^",
    "@maple/subprocess": "workspace:^",
    "@maple/subprocess-local": "workspace:^",
    "@maple/timeout": "workspace:^",
    "@maple/cordis": "workspace:^"
  }
}
