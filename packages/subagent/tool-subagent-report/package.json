{
  "name": "@maple/tool-subagent-report",
  "description": "Child-scoped report tool over ctx.subagents continuations",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlienBTw/maple-harness.git",
    "directory": "packages/subagent/tool-subagent-report"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@maple/invariants": "workspace:^",
    "@maple/llm": "workspace:^",
    "@maple/subagent": "workspace:^",
    "@maple/system-prompt": "workspace:^",
    "@maple/tools": "workspace:^",
    "@maple/cordis": "workspace:^"
  },
  "dependencies": {
    "@maple/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@maple/agent": "workspace:^",
    "@maple/agent-loop": "workspace:^",
    "@maple/agent-loop-testkit": "workspace:^",
    "@maple/invariants": "workspace:^",
    "@maple/llm": "workspace:^",
    "@maple/session": "workspace:^",
    "@maple/session-persistence": "workspace:^",
    "@maple/session-persistence-jsonl": "workspace:^",
    "@maple/subagent": "workspace:^",
    "@maple/subagent-spawn-in-process": "workspace:^",
    "@maple/system-prompt": "workspace:^",
    "@maple/tool-subagent-control": "workspace:^",
    "@maple/tools": "workspace:^",
    "@maple/cordis": "workspace:^"
  }
}
