{
  "name": "@maple/sdk-jsonrpc-server",
  "description": "Stdio JSON-RPC server plugin for out-of-process Maple Harness SDK clients",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlienBTw/maple-harness.git",
    "directory": "packages/sdk/server"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@maple/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@maple/agent": "workspace:^",
    "@maple/invariants": "workspace:^",
    "@maple/llm": "workspace:^",
    "@maple/llm-deepseek": "workspace:^",
    "@maple/scope": "workspace:^",
    "@maple/sdk-protocol": "workspace:^",
    "@maple/session": "workspace:^",
    "@maple/subagent": "workspace:^",
    "@maple/cordis": "workspace:^"
  },
  "devDependencies": {
    "@maple/cordis-plugin-loader": "workspace:^",
    "@maple/agent": "workspace:^",
    "@maple/agent-spine-demo": "workspace:^",
    "@maple/invariants": "workspace:^",
    "@maple/llm": "workspace:^",
    "@maple/llm-deepseek": "workspace:^",
    "@maple/scope": "workspace:^",
    "@maple/sdk-protocol": "workspace:^",
    "@maple/session": "workspace:^",
    "@maple/session-persistence-jsonl": "workspace:^",
    "@maple/subagent": "workspace:^",
    "@maple/cordis": "workspace:^"
  }
}
