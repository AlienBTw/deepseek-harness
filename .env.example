# 🍁 Maple Harness Configuration

# === Sovereign BYOK Proxy (Optional) ===
# Route all LLM traffic through the local/self-hosted Mapl Sovereign Proxy
# MAPLE_PROXY_URL=http://localhost:8787/v1
# MAPLE_PROXY_TOKEN=your-proxy-auth-token

# === Direct Provider API Keys (When not using proxy) ===
# DEEPSEEK_API_KEY=sk-...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# === Context & Repo-Map Settings ===
# MAPLE_MAP_TOKENS=2000
# MAPLE_MAX_WORKSPACE_FILES=5000
